# URL absoluta del sitio publicado, sin barra final.
# Alimenta el canonical, Open Graph, el sitemap.xml y el robots.txt.
# En Vercel se define en Project Settings > Environment Variables.
VITE_SITE_URL=http://localhost:5173

# Base de la API, incluida la versión. En desarrollo se usa localhost:8080
# si se omite; en Vercel es obligatoria.
VITE_API_URL=http://localhost:8080/api/v1
