# Copiar a .env (nunca versionar el real) y completar con los valores reales.

# --- Base de datos (Supabase) --------------------------------------------
# Para Render: usar el pooler Supavisor en modo *session*, no la conexión directa
# (DT-07) — el endpoint directo de Supabase es IPv6 y Render no lo resuelve de forma
# confiable. Se obtiene en el dashboard de Supabase:
# Settings → Database → Connection pooling → Session mode.
DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres
# El usuario del pooler incluye el project ref, no es sólo "postgres".
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=
DB_POOL_SIZE=10

# Para desarrollo LOCAL: la conexión directa también funciona si tu red tiene IPv6
# real (verificado 12/09). Si tu conexión no tiene IPv6, usá el pooler acá también.
# DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# DB_USERNAME=postgres

# --- JWT (DT-11) -----------------------------------------------------------
# Secreto largo y aleatorio (p. ej. `openssl rand -base64 48`). Nunca commitear el real.
JWT_SECRET=
JWT_EXPIRATION_MINUTES=480

# --- CORS (DT-19) ------------------------------------------------------------
# Orígenes separados por coma.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Servidor ----------------------------------------------------------------
# Render inyecta PORT automáticamente en producción; 8080 es el default local.
PORT=8080

# IA opcional: sólo Free Tier comprobado en AI Studio, clave NUEVA fuera de git.
AI_SUMMARY_ENABLED=false
GEMINI_API_KEY=
GEMINI_SUMMARY_MODEL=gemini-3.1-flash-lite
GEMINI_SUMMARY_FALLBACK_MODEL=
AI_SUMMARY_TIMEOUT_SECONDS=40
AI_SUMMARY_MAX_ATTEMPTS=3
AI_SUMMARY_MAX_CALLS_PER_MINUTE=3
AI_SUMMARY_MAX_CALLS_PER_DAY=20
